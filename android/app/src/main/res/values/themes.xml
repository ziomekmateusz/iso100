<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AppCompat for the per-app languages; black window, so the start never dazzles in red night -->
    <style name="Theme.Iso100" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Iso100.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">
            @drawable/splash_branding
        </item>
        <item name="postSplashScreenTheme">@style/Theme.Iso100</item>
    </style>
</resources>
